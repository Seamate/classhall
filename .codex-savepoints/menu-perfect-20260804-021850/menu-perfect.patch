+function classhall_replace_course_word_for_frontend( $text ) {
+    if ( ! is_string( $text ) || '' === $text ) {
+        return $text;
+    }
+
+    $replacements = array(
+        'Courses' => 'Subjects',
+        'courses' => 'subjects',
+        'Course'  => 'Subject',
+        'course'  => 'subject',
+    );
+
+    foreach ( $replacements as $from => $to ) {
+        $text = preg_replace( '/\b' . preg_quote( $from, '/' ) . '\b/u', $to, $text );
+    }
+
+    return $text;
+}
