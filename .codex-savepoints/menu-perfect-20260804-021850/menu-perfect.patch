+/******Classhall Clockam-inspired premium landing polish****/
+#classhall-home {
+    --ch-deep: #050b18;
+    --ch-deep-2: #0b1630;
+    --ch-glass: rgba(255, 255, 255, .075);
+    --ch-glass-strong: rgba(255, 255, 255, .12);
+    --ch-glass-line: rgba(255, 255, 255, .16);
+    --ch-premium-text: #f8fbff;
+    --ch-premium-muted: rgba(248, 251, 255, .72);
+    background: #ffffff;
+}
+
+#classhall-home .ch-hero {
+    min-height: calc(100vh - 92px);
+    padding: clamp(54px, 7vw, 104px) 0 clamp(58px, 7vw, 108px);
+    background:
+        radial-gradient(circle at 78% 18%, rgba(72, 132, 255, .38), transparent 31rem),
+        radial-gradient(circle at 18% 76%, rgba(163, 201, 254, .18), transparent 28rem),
+        linear-gradient(135deg, #050b18 0%, #0b1630 54%, #061022 100%);
+    color: var(--ch-premium-text);
+}
+
+#classhall-home .ch-collage-strip {
+    --ch-collage-duration: 40s;
+    --ch-collage-height: clamp(118px, 10.667vw, 320px);
+    display: grid;
+    gap: 14px;
+    width: 100%;
+    max-width: 100%;
+    padding: 16px 0;
+    overflow-x: hidden;
+    background: #ffffff;
+}
+
+#classhall-home .ch-collage-row {
+    width: 100%;
+    max-width: 100%;
+    overflow: hidden;
+}
+
+#classhall-home .ch-collage-track {
+    display: flex;
+    width: max-content;
+    max-width: none;
+    animation-duration: var(--ch-collage-duration);
+    animation-timing-function: linear;
+    animation-iteration-count: infinite;
+    will-change: transform;
+}
+
+#classhall-home .ch-collage-row-left .ch-collage-track {
+    animation-name: ch-collage-scroll-left;
+}
+
+#classhall-home .ch-collage-row-right .ch-collage-track {
+    animation-name: ch-collage-scroll-right;
+}
+
+#classhall-home .ch-collage-track img {
+    display: block;
+    width: calc(var(--ch-collage-height) * 9.375);
+    height: var(--ch-collage-height);
+    aspect-ratio: 3000 / 320;
+    max-width: none;
+    flex: 0 0 auto;
+}
+
+@keyframes ch-collage-scroll-left {
+    from {
+        transform: translate3d(0, 0, 0);
+    }
+
+    to {
+        transform: translate3d(-50%, 0, 0);
+    }
+}
+
+@keyframes ch-collage-scroll-right {
+    from {
+        transform: translate3d(-50%, 0, 0);
+    }
+
+    to {
+        transform: translate3d(0, 0, 0);
+    }
+}
+
+@media (prefers-reduced-motion: reduce) {
+    #classhall-home .ch-collage-track {
+        animation: none;
+        transform: translate3d(0, 0, 0);
+        will-change: auto;
+    }
+
+    #classhall-home .ch-collage-track img[aria-hidden="true"] {
+        display: none;
+    }
+}
+
